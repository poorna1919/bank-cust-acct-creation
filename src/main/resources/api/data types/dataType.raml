#%RAML 1.0 DataType
type: object
additionalProperties: false
properties:
  accountNum:
    required: true
    minLength: 10
    maxLength: 10
  atmPin:
    required: true
    type: string
    minLength: 4
    maxLength: 4
  ifscCode:
    required: true
    minLength: 4
    maxLength: 10
  depositAmount:
    required: false
    type: number
  mailId:
    required: true
    type: string
  contact:
    required: true
    type: string